{
  "name": "aromia-lab-tooling",
  "private": true,
  "version": "0.4.0",
  "description": "Tooling de raíz del repo. Apps/web y apps/api conservan sus propios package.json y builds; este paquete expone utilidades operativas para imágenes, catálogo y quality gates.",
  "type": "module",
  "scripts": {
    "images:audit-pilot": "node scripts/audit-image-pilot.mjs",
    "catalog:validate": "node scripts/catalog/validate.mjs",
    "catalog:normalize": "node scripts/catalog/normalize.mjs",
    "catalog:dedupe": "node scripts/catalog/deduplicate.mjs",
    "catalog:diff": "node scripts/catalog/diff.mjs",
    "catalog:prepare": "node scripts/catalog/prepare-import.mjs",
    "catalog:import": "node scripts/catalog/import.mjs",
    "catalog:calibrate": "node scripts/catalog/calibrate.mjs",
    "catalog:apply-remediation": "node scripts/catalog/apply-remediation.mjs",
    "catalog:engine": "node scripts/catalog/engine.mjs",
    "catalog:sourcing": "node scripts/catalog/sourcing.mjs",
    "catalog:test": "npm --prefix scripts/catalog test",
    "catalog:audit:ccl": "node scripts/catalog/ccl-production-audit.mjs",
    "audit:omni": "node scripts/omni-strict-audit.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3"
  }
}
