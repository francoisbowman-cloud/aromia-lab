{
  "name": "@aromia/catalog-scripts",
  "private": true,
  "version": "0.2.0",
  "description": "Pipeline y motor de expansión de catálogo de Aromia (Fase 3 — Catalog Data Pipeline & Expansion 500). No forma parte del build de apps/web ni apps/api. Nunca escribe a Postgres de producción.",
  "type": "module",
  "scripts": {
    "validate": "node validate.mjs",
    "normalize": "node normalize.mjs",
    "dedupe": "node deduplicate.mjs",
    "diff": "node diff.mjs",
    "prepare-import": "node prepare-import.mjs",
    "import": "node import.mjs",
    "calibrate": "node calibrate.mjs",
    "apply-remediation": "node apply-remediation.mjs",
    "engine": "node engine.mjs",
    "expand:v2": "node expansion-engine.mjs 100",
    "harvest:v2": "node expansion-harvest-v2.mjs 100",
    "enrich:v2": "node expansion-enrich-v2.mjs",
    "build-batch:v2": "node expansion-batch-builder-v2.mjs",
    "gate:v2": "node expansion-gate-v2.mjs",
    "test": "node --test --test-concurrency=1 tests/",
    "posttest": "node tests/cleanup-artifacts.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.1"
  }
}
