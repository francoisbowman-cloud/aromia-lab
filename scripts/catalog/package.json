  "version": "0.1.0",
  "description": "Pipeline de importación de catálogo de Aromia (Fase 3 — Catalog Data Pipeline & Expansion 500). No forma parte del build de apps/web ni apps/api. Nunca escribe a Postgres de producción.",
  "type": "module",
  "scripts": {
    "validate": "node validate.mjs",
